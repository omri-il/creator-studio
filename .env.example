# Creator Studio secrets. Copy to `.env` (gitignored) and fill in.
# Preferences (project id, subdomain, Event-Engine URL, exports folder) are NOT
# here — they live in settings.json and are editable from the app's VSL panel.

# Wistia account -> Settings -> API Access
WISTIA_API_TOKEN=

# Must equal MEDIA_API_TOKEN in that Event-Engine instance's own .env
EVENT_ENGINE_TOKEN=
